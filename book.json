{
  "title": "Active Directory Hardening Guidebook",
  "description": "Production-Grade Hardening Requirements & Guidelines for Air-Gapped Environments",
  "language": "en",
  "plugins": [
    "-sharing",
    "-lunr",
    "-search",
    "prism",
    "-highlight",
    "flexible-alerts",
    "search-plus"
  ],
  "pluginsConfig": {
    "prism": {
      "lang": {
        "cmd": "batch"
      },
      "ignore": [
        "mermaid",
        "text",
        "none",
        "plain"
      ]
    }
  },
  "styles": {
    "website": "styles/website.css"
  }
}
